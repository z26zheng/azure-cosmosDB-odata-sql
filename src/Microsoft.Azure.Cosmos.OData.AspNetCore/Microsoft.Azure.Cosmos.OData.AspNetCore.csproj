<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Microsoft.Azure.Cosmos.OData.AspNetCore</RootNamespace>
    <AssemblyName>Microsoft.Azure.Cosmos.OData.AspNetCore</AssemblyName>
    <PackageId>Microsoft.Azure.Cosmos.OData.AspNetCore</PackageId>
    <Description>
      ASP.NET Core adapter for Microsoft.Azure.Cosmos.OData.
      Provides extension methods on ODataQueryOptions and DI integration
      via AddODataToCosmosSql().
    </Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OData" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Azure.Cosmos.OData\Microsoft.Azure.Cosmos.OData.csproj" />
  </ItemGroup>

</Project>
