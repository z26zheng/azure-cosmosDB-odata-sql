<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Microsoft.Azure.Cosmos.OData.AspNetCore</RootNamespace>
    <AssemblyName>Microsoft.Azure.Cosmos.OData.AspNetCore</AssemblyName>
    <PackageId>CosmosDB.OData.Sql.AspNetCore</PackageId>
    <Description>
      ASP.NET Core adapter for CosmosDB.OData.Sql. Supports .NET 8, .NET 9, and .NET 10.
      Provides ODataQueryOptions.Translate() extension methods and AddODataToCosmosSql()
      DI registration for seamless OData-to-Cosmos integration in ASP.NET Core apps.
    </Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OData" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Azure.Cosmos.OData\Microsoft.Azure.Cosmos.OData.csproj" />
  </ItemGroup>

</Project>
