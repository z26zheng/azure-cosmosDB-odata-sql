<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Microsoft.Azure.Cosmos.OData</RootNamespace>
    <AssemblyName>Microsoft.Azure.Cosmos.OData</AssemblyName>
    <PackageId>CosmosDB.OData.Sql</PackageId>
    <Description>
      Translates OData V4 queries into Azure Cosmos DB SQL. Supports .NET 8, .NET 9, and .NET 10.
      Framework-agnostic engine with 50+ Cosmos DB function mappings, parameterized queries,
      OFFSET/LIMIT pagination, $apply/GROUP BY, vector search, full-text search, and geospatial.
      No ASP.NET or Cosmos SDK dependency required.
    </Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.OData.Core" />
    <PackageReference Include="Microsoft.OData.Edm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
