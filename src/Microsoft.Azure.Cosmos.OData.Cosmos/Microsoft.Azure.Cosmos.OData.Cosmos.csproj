<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Microsoft.Azure.Cosmos.OData.Cosmos</RootNamespace>
    <AssemblyName>Microsoft.Azure.Cosmos.OData.Cosmos</AssemblyName>
    <PackageId>CosmosDB.OData.Sql.Cosmos</PackageId>
    <Description>
      Cosmos SDK bridge for CosmosDB.OData.Sql. Supports .NET 8, .NET 9, and .NET 10.
      Converts TranslatedQuery into QueryDefinition with parameters.
      Includes Container.GetODataQueryIterator() for direct query execution.
    </Description>
    <IsPackable>true</IsPackable>
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Cosmos" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Azure.Cosmos.OData\Microsoft.Azure.Cosmos.OData.csproj" />
  </ItemGroup>

</Project>
